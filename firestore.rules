rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Ships collection (Synchronized across all devices)
    match /ships/{shipId} {
      allow read, write: if true;
    }

    // Routes collection (Synchronized across all devices)
    match /routes/{routeId} {
      allow read, write: if true;
    }

    // Schedules collection (Synchronized across all devices)
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Cargo Shipments (Synchronized across all devices)
    match /cargo_shipments/{shipmentId} {
      allow read, write: if true;
    }

    // Passenger Tickets (Synchronized across all devices)
    match /passenger_tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}
